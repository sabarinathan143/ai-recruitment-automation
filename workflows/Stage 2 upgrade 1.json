        "messages": {
          "values": [
            {
              "content": "=You are extracting structured recruitment data from a CV.\n\nUse ONLY the CV text below.\nDo not guess or invent information.\nIf a field is missing, return null.\n\nReturn ONLY valid JSON.\nDo not use markdown.\nDo not add explanations.\n\nUse exactly this structure:\n\n{\n  \"candidate_name\": null,\n  \"email\": null,\n  \"phone\": null,\n  \"location\": null,\n  \"job_role\": null,\n  \"experience_years\": null,\n  \"skills\": [],\n  \"qualifications\": [],\n  \"availability\": null,\n  \"salary_expectation\": null,\n  \"recruiter_summary\": null\n}\n\nFor skills:\n- Include only skills explicitly stated in the CV.\n- Do not infer skills from responsibilities or job duties.\n- Do not add soft skills unless they are explicitly written in the CV.\n- Do not invent or paraphrase skills.\n- Return a maximum of 10 skills.\n\nCV TEXT:\n {{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        608,
        176
      ],
      "id": "9617f855-4c6b-4963-be7c-ad9537578bc0",

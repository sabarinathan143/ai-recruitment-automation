    {
      "parameters": {
        "jsCode": "let text = $json.content;\n\ntext = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n\ntry {\n  const data = JSON.parse(text);\n  return [{ json: data }];\n} catch (error) {\n  return [{\n    json: {\n      parse_error: true,\n      raw_output: text,\n      error_message: error.message\n    }\n  }];\n}"
      },
